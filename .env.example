# Environment Variable Configuration - VoyageML
PORT=8000
HOST=127.0.0.1

# External APIs (Optional - Open-Meteo and OSRM fallbacks built-in)
OPENWEATHER_API_KEY=
OPENROUTESERVICE_API_KEY=

# MongoDB Configuration (Optional - Falls back to local SQLite if empty)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=wayvista

# SMTP Email Configuration for Email Verification Code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@wayvista.com

